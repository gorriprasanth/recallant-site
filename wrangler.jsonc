{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recallant-site",
  "main": "_build/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "assets": {
    "directory": ".cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {"DEPLOYMENT_ENV": "production"},
  "env": {
    "preview": {
      "name": "recallant-site-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {"DEPLOYMENT_ENV": "preview"}
    }
  }
}
